<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard | Job Tracker</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap"
        rel="stylesheet">
    <style>
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
        }

        /* Custom scrollbar for a cleaner look */
        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }

        ::-webkit-scrollbar-track {
            background: transparent;
        }

        ::-webkit-scrollbar-thumb {
            background: #e7e5e4;
            border-radius: 10px;
        }

        ::-webkit-scrollbar-thumb:hover {
            background: #d6d3d1;
        }
    </style>
</head>

<body class="bg-[#F9F8F5] h-screen overflow-hidden flex text-stone-800">

    <aside class="w-64 bg-white border-r border-stone-100 flex flex-col justify-between hidden md:flex">
        <div>
            <div class="h-20 flex items-center px-8 border-b border-stone-100">
                <div class="w-8 h-8 bg-orange-50 text-orange-600 rounded-lg flex items-center justify-center mr-3">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round"
                            d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z">
                        </path>
                    </svg>
                </div>
                <span class="font-bold text-lg tracking-tight">DevTrack</span>
            </div>

            <nav class="p-4 space-y-1.5">
                <a href="#"
                    class="flex items-center px-4 py-3 bg-stone-50 text-stone-900 rounded-xl font-semibold text-sm transition-colors">
                    <svg class="w-5 h-5 mr-3 text-stone-500" fill="none" stroke="currentColor" stroke-width="2"
                        viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round"
                            d="M3.75 6A2.25 2.25 0 016 3.75h2.25A2.25 2.25 0 0110.5 6v2.25a2.25 2.25 0 01-2.25 2.25H6a2.25 2.25 0 01-2.25-2.25V6zM3.75 15.75A2.25 2.25 0 016 13.5h2.25a2.25 2.25 0 012.25 2.25V18a2.25 2.25 0 01-2.25 2.25H6A2.25 2.25 0 013.75 18v-2.25zM13.5 6a2.25 2.25 0 012.25-2.25H18A2.25 2.25 0 0120.25 6v2.25A2.25 2.25 0 0118 10.5h-2.25a2.25 2.25 0 01-2.25-2.25V6zM13.5 15.75a2.25 2.25 0 012.25-2.25H18a2.25 2.25 0 012.25 2.25V18A2.25 2.25 0 0118 20.25h-2.25A2.25 2.25 0 0113.5 18v-2.25z">
                        </path>
                    </svg>
                    Dashboard
                </a>
                <a href="#"
                    class="flex items-center px-4 py-3 text-stone-500 hover:bg-stone-50 hover:text-stone-900 rounded-xl font-medium text-sm transition-colors">
                    <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round"
                            d="M2.25 12.75V12A2.25 2.25 0 014.5 9.75h15A2.25 2.25 0 0121.75 12v.75m-8.69-6.44l-2.12-2.12a1.5 1.5 0 00-1.061-.44H4.5A2.25 2.25 0 002.25 6v12a2.25 2.25 0 002.25 2.25h15A2.25 2.25 0 0021.75 18V9a2.25 2.25 0 00-2.25-2.25h-5.379a1.5 1.5 0 01-1.06-.44z">
                        </path>
                    </svg>
                    Applications
                </a>
                <a href="#"
                    class="flex items-center px-4 py-3 text-stone-500 hover:bg-stone-50 hover:text-stone-900 rounded-xl font-medium text-sm transition-colors">
                    <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round"
                            d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5">
                        </path>
                    </svg>
                    Interviews
                </a>
            </nav>
        </div>

        <div class="p-4 border-t border-stone-100">
            <a href="#" class="flex items-center p-3 rounded-xl hover:bg-stone-50 transition-colors">
                <div class="w-9 h-9 rounded-full bg-stone-200 overflow-hidden flex-shrink-0">
                    <img src="../public/images/images.jpg" alt="Profile" class="w-full h-full object-cover">
                </div>
                <div class="ml-3 overflow-hidden">
                    <p class="text-sm font-semibold text-stone-900 truncate"><%= user.username%></p>
                    <p class="text-xs text-stone-500 truncate"><%= user.passion%></p>
                    <p class="text-xs text-stone-500 truncate"><%= user.role%></p>
                     <a href="/user/profile" class="text-xs text-stone-500 truncate">see details</span>
                </div>
                <div class="ml-3 overflow-hidden">
                  <a href="/logout">logout</a>
                </div>
            </a>
        </div>
    </aside>

    <main class="flex-1 overflow-y-auto">
        <div class="max-w-6xl mx-auto p-6 md:p-10">

            <header class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-10">
                <div>
                    <h1 class="text-2xl md:text-3xl font-bold text-stone-900 tracking-tight">Overview</h1>
                    <p class="text-stone-500 text-sm mt-1">Track and manage your job search progress.</p>
                </div>
                <button
                    class="bg-stone-900 hover:bg-stone-800 text-white font-semibold rounded-xl px-5 py-2.5 transition-colors shadow-lg shadow-stone-900/10 text-sm flex items-center justify-center gap-2 self-start sm:self-auto">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"></path>
                    </svg>
                    Add Application
                </button>
            </header>

            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-10">
                <div class="bg-white p-5 rounded-[1.5rem] border border-stone-100 shadow-sm flex flex-col">
                    <div class="w-10 h-10 rounded-xl bg-stone-50 flex items-center justify-center text-stone-600 mb-4">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round"
                                d="M9 12h3.75M9 15h3.75M9 18h3.75m3 .75H18a2.25 2.25 0 002.25-2.25V6.108c0-1.135-.845-2.098-1.976-2.192a48.424 48.424 0 00-1.123-.08m-5.801 0c-.065.21-.1.433-.1.664 0 .414.336.75.75.75h4.5a.75.75 0 00.75-.75 2.25 2.25 0 00-.1-.664m-5.8 0A2.251 2.251 0 0113.5 2.25H15c1.012 0 1.867.668 2.15 1.586m-5.8 0c-.376.023-.75.05-1.124.08C9.095 4.01 8.25 4.973 8.25 6.108V8.25m0 0H4.875c-.621 0-1.125.504-1.125 1.125v11.25c0 .621.504 1.125 1.125 1.125h9.75c.621 0 1.125-.504 1.125-1.125V9.375c0-.621-.504-1.125-1.125-1.125H8.25zM6.75 12h.008v.008H6.75V12zm0 3h.008v.008H6.75V15zm0 3h.008v.008H6.75V18z">
                            </path>
                        </svg>
                    </div>
                    <p class="text-stone-500 text-sm font-medium">Total Applied</p>
                    <p class="text-3xl font-bold text-stone-900 mt-1">42</p>
                </div>

                <div class="bg-white p-5 rounded-[1.5rem] border border-stone-100 shadow-sm flex flex-col">
                    <div
                        class="w-10 h-10 rounded-xl bg-orange-50 flex items-center justify-center text-orange-600 mb-4">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z">
                            </path>
                            <path stroke-linecap="round" stroke-linejoin="round"
                                d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z"></path>
                        </svg>
                    </div>
                    <p class="text-stone-500 text-sm font-medium">Interviewing</p>
                    <p class="text-3xl font-bold text-stone-900 mt-1">6</p>
                </div>

                <div class="bg-white p-5 rounded-[1.5rem] border border-stone-100 shadow-sm flex flex-col">
                    <div class="w-10 h-10 rounded-xl bg-green-50 flex items-center justify-center text-green-600 mb-4">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round"
                                d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                        </svg>
                    </div>
                    <p class="text-stone-500 text-sm font-medium">Offers</p>
                    <p class="text-3xl font-bold text-stone-900 mt-1">2</p>
                </div>

                <div class="bg-white p-5 rounded-[1.5rem] border border-stone-100 shadow-sm flex flex-col">
                    <div class="w-10 h-10 rounded-xl bg-red-50 flex items-center justify-center text-red-600 mb-4">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round"
                                d="M9.75 9.75l4.5 4.5m0-4.5l-4.5 4.5M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                        </svg>
                    </div>
                    <p class="text-stone-500 text-sm font-medium">Rejected</p>
                    <p class="text-3xl font-bold text-stone-900 mt-1">14</p>
                </div>
            </div>

       <div class="bg-white rounded-[1.5rem] border border-stone-100 shadow-sm overflow-hidden">

    <div class="px-6 py-5 border-b border-stone-100 flex justify-between items-center">
        <h2 class="font-bold text-lg text-stone-900">Recent Jobs</h2>

        <a href="#"
            class="text-sm font-semibold text-orange-600 hover:text-orange-700 transition-colors">
            View all
        </a>
    </div>

    <div class="overflow-x-auto">

        <table class="w-full text-left border-collapse">

            <thead>
                <tr class="bg-stone-50/50">

                    <th class="px-6 py-4 text-xs font-semibold text-stone-500 uppercase tracking-wider">
                        Company & Role
                    </th>

                    <th class="px-6 py-4 text-xs font-semibold text-stone-500 uppercase tracking-wider">
                        Date Posted
                    </th>

                    <th class="px-6 py-4 text-xs font-semibold text-stone-500 uppercase tracking-wider">
                        Job Type
                    </th>

                    <th class="px-6 py-4 text-xs font-semibold text-stone-500 uppercase tracking-wider">
                        Location
                    </th>

                    <th class="px-6 py-4 text-xs font-semibold text-stone-500 uppercase tracking-wider text-right">
                        Actions
                    </th>

                </tr>
            </thead>

            <tbody class="divide-y divide-stone-100">

                <% jobs.forEach((job) => { %>

                    <tr class="hover:bg-stone-50/50 transition-colors">

                        <!-- Company & Role -->
                        <td class="px-6 py-4">

                            <div class="flex flex-col">

                                <span class="font-semibold text-stone-900 text-sm">
                                    <%= job.firmName %>
                                </span>

                                <span class="text-xs text-stone-500 mt-0.5">
                                    <%= job.title %>
                                </span>

                            </div>

                        </td>


                        <!-- Date -->
                        <td class="px-6 py-4 text-sm text-stone-600">

                            <%= new Date(job.createdAt).toLocaleDateString('en-US', {
                                month: 'short',
                                day: '2-digit',
                                year: 'numeric'
                            }) %>

                        </td>


                        <!-- Job Type -->
                        <td class="px-6 py-4">

                            <span
                                class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium bg-orange-50 text-orange-700 border border-orange-100">

                                <%= job.jobType %>

                            </span>

                        </td>


                        <!-- Location -->
                        <td class="px-6 py-4 text-sm text-stone-600">

                            <%= job.location %>

                        </td>


                        <!-- Actions -->
                        <td class="px-6 py-4 text-right">

                            <button
                                class="text-stone-400 hover:text-stone-900 transition-colors">

                                <svg class="w-5 h-5" fill="none" stroke="currentColor"
                                    stroke-width="2" viewBox="0 0 24 24">

                                    <path stroke-linecap="round"
                                        stroke-linejoin="round"
                                        d="M12 6.75a.75.75 0 110-1.5.75.75 0 010 1.5zM12 12.75a.75.75 0 110-1.5.75 0 010 1.5zM12 18.75a.75.75 0 110-1.5.75 0 010 1.5z">
                                    </path>

                                </svg>

                            </button>

                        </td>

                    </tr>

                <% }) %>

            </tbody>

        </table>

    </div>

</div>
        </div>
    </main>
</body>

</html>
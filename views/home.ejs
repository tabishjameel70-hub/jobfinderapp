<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Dashboard | Job Tracker</title>

    <script src="https://cdn.tailwindcss.com"></script>

    <link
        href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap"
        rel="stylesheet">

    <style>
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
        }

        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }

        ::-webkit-scrollbar-track {
            background: transparent;
        }

        ::-webkit-scrollbar-thumb {
            background: #e7e5e4;
            border-radius: 10px;
        }

        ::-webkit-scrollbar-thumb:hover {
            background: #d6d3d1;
        }
    </style>
</head>


<body class="bg-[#F9F8F5] h-screen overflow-hidden flex text-stone-800">


    <!-- SIDEBAR -->
    <aside class="w-64 bg-white border-r border-stone-100 flex flex-col justify-between hidden md:flex">

        <div>

            <!-- Logo -->
            <div class="h-20 flex items-center px-8 border-b border-stone-100">

                <div
                    class="w-8 h-8 bg-orange-50 text-orange-600 rounded-lg flex items-center justify-center mr-3">

                    <svg class="w-4 h-4" fill="none" stroke="currentColor"
                        stroke-width="2" viewBox="0 0 24 24">

                        <path stroke-linecap="round"
                            stroke-linejoin="round"
                            d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z">
                        </path>

                    </svg>

                </div>

                <span class="font-bold text-lg tracking-tight">
                    DevTrack
                </span>

            </div>


            <!-- Navigation -->
            <nav class="p-4 space-y-1.5">

                <a href="/"
                    class="flex items-center px-4 py-3 bg-stone-50 text-stone-900 rounded-xl font-semibold text-sm">

                    <svg class="w-5 h-5 mr-3 text-stone-500"
                        fill="none" stroke="currentColor"
                        stroke-width="2" viewBox="0 0 24 24">

                        <path stroke-linecap="round"
                            stroke-linejoin="round"
                            d="M3.75 6A2.25 2.25 0 016 3.75h2.25A2.25 2.25 0 0110.5 6v2.25a2.25 2.25 0 01-2.25 2.25H6a2.25 2.25 0 01-2.25-2.25V6zM3.75 15.75A2.25 2.25 0 016 13.5h2.25a2.25 2.25 0 012.25 2.25V18a2.25 2.25 0 01-2.25 2.25H6A2.25 2.25 0 013.75 18v-2.25zM13.5 6a2.25 2.25 0 012.25-2.25H18A2.25 2.25 0 0120.25 6v2.25A2.25 2.25 0 0118 10.5h-2.25a2.25 2.25 0 01-2.25-2.25V6zM13.5 15.75a2.25 2.25 0 012.25-2.25H18a2.25 2.25 0 012.25 2.25V18A2.25 2.25 0 0118 20.25h-2.25A2.25 2.25 0 0113.5 18v-2.25z">
                        </path>

                    </svg>

                    Dashboard

                </a>


                <a href="/jobs"
                    class="flex items-center px-4 py-3 text-stone-500 hover:bg-stone-50 hover:text-stone-900 rounded-xl font-medium text-sm transition-colors">

                    <svg class="w-5 h-5 mr-3"
                        fill="none" stroke="currentColor"
                        stroke-width="2" viewBox="0 0 24 24">

                        <path stroke-linecap="round"
                            stroke-linejoin="round"
                            d="M2.25 12.75V12A2.25 2.25 0 014.5 9.75h15A2.25 2.25 0 0121.75 12v.75m-8.69-6.44l-2.12-2.12a1.5 1.5 0 00-1.061-.44H4.5A2.25 2.25 0 002.25 6v12a2.25 2.25 0 002.25 2.25h15A2.25 2.25 0 0021.75 18V9a2.25 2.25 0 00-2.25-2.25h-5.379a1.5 1.5 0 01-1.06-.44z">
                        </path>

                    </svg>

                    Jobs

                </a>


                <a href="/candidates"
                    class="flex items-center px-4 py-3 text-stone-500 hover:bg-stone-50 hover:text-stone-900 rounded-xl font-medium text-sm transition-colors">

                    <svg class="w-5 h-5 mr-3"
                        fill="none" stroke="currentColor"
                        stroke-width="2" viewBox="0 0 24 24">

                        <path stroke-linecap="round"
                            stroke-linejoin="round"
                            d="M15 19.128a9.38 9.38 0 002.625.372 9.337 9.337 0 004.121-.952 4.125 4.125 0 00-7.533-2.493M15 19.128v-.003c0-.355-.063-.697-.178-1.008M15 19.128a9.38 9.38 0 01-3 .498 9.38 9.38 0 01-3-.498m6 0a9.38 9.38 0 01-6 0m-9.75 4.125a9.38 9.38 0 002.625.372 9.337 9.337 0 004.121-.952 4.125 4.125 0 00-7.533-2.493M3 19.128v-.003c0-.355.063-.697.178-1.008M3 19.128a9.38 9.38 0 006 .498">
                        </path>

                    </svg>

                    Candidates

                </a>


                <a href="#"
                    class="flex items-center px-4 py-3 text-stone-500 hover:bg-stone-50 hover:text-stone-900 rounded-xl font-medium text-sm transition-colors">

                    <svg class="w-5 h-5 mr-3"
                        fill="none" stroke="currentColor"
                        stroke-width="2" viewBox="0 0 24 24">

                        <path stroke-linecap="round"
                            stroke-linejoin="round"
                            d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5">
                        </path>

                    </svg>

                    Interviews

                </a>

            </nav>

        </div>


        <!-- User -->
        <div class="p-4 border-t border-stone-100">

            <div class="flex items-center p-3 rounded-xl">

                <div
                    class="w-9 h-9 rounded-full bg-stone-200 overflow-hidden flex-shrink-0">

                    <img
                        src="/images/images.jpg"
                        alt="Profile"
                        class="w-full h-full object-cover">

                </div>


                <div class="ml-3 overflow-hidden flex-1">

                    <p class="text-sm font-semibold text-stone-900 truncate">
                        <%= user.username %>
                    </p>

                    <p class="text-xs text-stone-500 truncate">
                        <%= user.passion %>
                    </p>

                    <p class="text-xs text-stone-500 truncate">
                        <%= user.role %>
                    </p>

                    <a href="/user/profile"
                        class="text-xs text-orange-600 hover:text-orange-700">
                        See details
                    </a>

                </div>


                <a href="/logout"
                    class="ml-2 text-xs text-stone-500 hover:text-red-500">
                    Logout
                </a>

            </div>

        </div>

    </aside>


    <!-- MAIN -->
    <main class="flex-1 overflow-y-auto">

        <div class="max-w-6xl mx-auto p-6 md:p-10">


            <!-- Header -->
            <header
                class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-10">

                <div>

                    <h1 class="text-2xl md:text-3xl font-bold text-stone-900 tracking-tight">
                        Overview
                    </h1>

                    <p class="text-stone-500 text-sm mt-1">
                        Track and manage your job search progress.
                    </p>

                </div>

                <a href="/jobs"
                    class="bg-stone-900 hover:bg-stone-800 text-white font-semibold rounded-xl px-5 py-2.5 transition-colors shadow-lg text-sm flex items-center justify-center gap-2">

                    <svg class="w-4 h-4"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        viewBox="0 0 24 24">

                        <path stroke-linecap="round"
                            stroke-linejoin="round"
                            d="M12 4.5v15m7.5-7.5h-15">
                        </path>

                    </svg>

                    Find Jobs

                </a>

            </header>


            <!-- Stats -->
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-10">


                <!-- Total Applied -->
                <div
                    class="bg-white p-5 rounded-[1.5rem] border border-stone-100 shadow-sm">

                    <div
                        class="w-10 h-10 rounded-xl bg-stone-50 flex items-center justify-center text-stone-600 mb-4">

                        📄

                    </div>

                    <p class="text-stone-500 text-sm font-medium">
                        Total Applied
                    </p>

                    <p class="text-3xl font-bold text-stone-900 mt-1">
                        42
                    </p>

                </div>


                <!-- Interviewing -->
                <div
                    class="bg-white p-5 rounded-[1.5rem] border border-stone-100 shadow-sm">

                    <div
                        class="w-10 h-10 rounded-xl bg-orange-50 flex items-center justify-center text-orange-600 mb-4">

                        📍

                    </div>

                    <p class="text-stone-500 text-sm font-medium">
                        Interviewing
                    </p>

                    <p class="text-3xl font-bold text-stone-900 mt-1">
                        6
                    </p>

                </div>


                <!-- Offers -->
                <div
                    class="bg-white p-5 rounded-[1.5rem] border border-stone-100 shadow-sm">

                    <div
                        class="w-10 h-10 rounded-xl bg-green-50 flex items-center justify-center text-green-600 mb-4">

                        ✓

                    </div>

                    <p class="text-stone-500 text-sm font-medium">
                        Offers
                    </p>

                    <p class="text-3xl font-bold text-stone-900 mt-1">
                        2
                    </p>

                </div>


                <!-- Rejected -->
                <div
                    class="bg-white p-5 rounded-[1.5rem] border border-stone-100 shadow-sm">

                    <div
                        class="w-10 h-10 rounded-xl bg-red-50 flex items-center justify-center text-red-600 mb-4">

                        ✕

                    </div>

                    <p class="text-stone-500 text-sm font-medium">
                        Rejected
                    </p>

                    <p class="text-3xl font-bold text-stone-900 mt-1">
                        14
                    </p>

                </div>

            </div>


            <!-- Recent Jobs -->
            <div
                class="bg-white rounded-[1.5rem] border border-stone-100 shadow-sm overflow-hidden">

                <div
                    class="px-6 py-5 border-b border-stone-100 flex justify-between items-center">

                    <h2 class="font-bold text-lg text-stone-900">
                        Recent Jobs
                    </h2>

                    <a href="/jobs"
                        class="text-sm font-semibold text-orange-600 hover:text-orange-700">
                        View all
                    </a>

                </div>


                <div class="overflow-x-auto">

                    <table class="w-full text-left border-collapse">

                        <thead>

                            <tr class="bg-stone-50/50">

                                <th class="px-6 py-4 text-xs font-semibold text-stone-500 uppercase tracking-wider">
                                    Company & Role
                                </th>

                                <th class="px-6 py-4 text-xs font-semibold text-stone-500 uppercase tracking-wider">
                                    Date Posted
                                </th>

                                <th class="px-6 py-4 text-xs font-semibold text-stone-500 uppercase tracking-wider">
                                    Job Type
                                </th>

                                <th class="px-6 py-4 text-xs font-semibold text-stone-500 uppercase tracking-wider">
                                    Location
                                </th>

                         
                                <th class="px-6 py-4 text-xs font-semibold text-stone-500 uppercase tracking-wider text-right">
                                    Actions
                                </th>

                            </tr>

                        </thead>


                     <tbody class="divide-y divide-stone-100">

    <% if (jobs && jobs.length > 0) { %>

        <% jobs.forEach((job) => { %>

            <tr class="hover:bg-stone-50/50 transition-colors">

                <!-- Company & Role -->
                <td class="px-6 py-4">

                    <div class="flex flex-col">

                        <span class="font-semibold text-stone-900 text-sm">
                            <%= job.company
                                ? job.company.companyName
                                : (job.firmName || "Company not provided")
                            %>
                        </span>

                        <span class="text-xs text-stone-500 mt-0.5">
                            <%= job.title || "Job title not provided" %>
                        </span>

                    </div>

                </td>


                <!-- Date -->
                <td class="px-6 py-4 text-sm text-stone-600">

                    <%= job.createdAt
                        ? new Date(job.createdAt).toLocaleDateString('en-US', {
                            month: 'short',
                            day: '2-digit',
                            year: 'numeric'
                        })
                        : "N/A"
                    %>

                </td>


                <!-- Job Type -->
                <td class="px-6 py-4">

                    <span
                        class="inline-flex items-center px-2.5 py-1 rounded-full
                        text-xs font-medium bg-orange-50 text-orange-700
                        border border-orange-100">

                        <%= job.jobType || "Not specified" %>

                    </span>

                </td>


                <!-- Location -->
                <td class="px-6 py-4 text-sm text-stone-600">

                    <%= job.company.location || "Not specified" %>

                </td>


                <!-- Action -->
                <td class="px-6 py-4 text-right">

                    <a href="/jobDetails?id=<%= job._id %>"
                        class="text-sm font-semibold text-orange-600 hover:text-orange-700">

                        View

                    </a>

                </td>

            </tr>

        <% }) %>

    <% } else { %>

        <tr>

            <td colspan="6" class="px-6 py-12 text-center">

                <div class="text-stone-400 text-3xl mb-3">
                    💼
                </div>

                <p class="text-stone-600 font-medium">
                    No jobs available
                </p>

                <p class="text-stone-400 text-sm mt-1">
                    There are no job postings yet.
                </p>

            </td>

        </tr>

    <% } %>

</tbody>

                    </table>

                </div>

            </div>

        </div>

    </main>

</body>

</html>
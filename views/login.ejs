<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Job Tracker Log In</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Plus Jakarta Sans', sans-serif; }
    </style>
</head>
<body class="bg-[#F9F8F5] min-h-screen flex items-center justify-center p-4">

    <!-- Main Container -->
    <div class="bg-white rounded-[2rem] shadow-sm w-full max-w-4xl flex flex-col lg:flex-row p-3 gap-3 border border-stone-100">
        
        <!-- Left Column: Form -->
        <div class="w-full lg:w-1/2 flex flex-col justify-center py-8 px-6 sm:px-10">
            
            <!-- Icon -->
            <div class="mb-6 w-10 h-10 bg-orange-50 text-orange-600 rounded-xl flex items-center justify-center">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 9V5.25A2.25 2.25 0 0013.5 3h-6a2.25 2.25 0 00-2.25 2.25v13.5A2.25 2.25 0 007.5 21h6a2.25 2.25 0 002.25-2.25V15M12 9l-3 3m0 0l3 3m-3-3h12.75"></path>
                </svg>
            </div>
            
            <!-- Headers -->
            <h1 class="text-3xl font-bold text-stone-900 mb-2 tracking-tight">Welcome back</h1>
            <p class="text-stone-500 text-sm mb-8">Enter your details to access your application dashboard.</p>

            <!-- Form Fields -->
            <form action="/login" method="POST" class="w-full space-y-4">
                
                <div>
                    <label for="email" class="block text-sm font-semibold text-stone-800 mb-1.5">Email address</label>
                    <input type="email" id="email" name="email" required placeholder="john@example.com" class="w-full border-2 border-stone-100 rounded-xl px-3 py-2.5 outline-none focus:border-orange-200 focus:ring-4 focus:ring-orange-50/50 placeholder-stone-400 text-sm transition-all" />
                </div>

                <div>
                    <div class="flex justify-between items-center mb-1.5">
                        <label for="password" class="block text-sm font-semibold text-stone-800">Password</label>
                        <a href="/forgot-password" class="text-xs font-semibold text-orange-600 hover:text-orange-700 transition-colors">Forgot password?</a>
                    </div>
                    <input type="password" id="password" name="password" required placeholder="••••••••" class="w-full border-2 border-stone-100 rounded-xl px-3 py-2.5 outline-none focus:border-orange-200 focus:ring-4 focus:ring-orange-50/50 placeholder-stone-400 text-sm transition-all" />
                </div>

                <!-- Submit Button -->
                <div class="pt-2">
                    <button  type="submit" class="w-full bg-stone-900 hover:bg-stone-800 text-white font-semibold rounded-xl py-3 transition-colors shadow-lg shadow-stone-900/10 text-sm">
                        Sign in
                    </button>
                </div>
         
                <!-- Sign Up Link -->
                <div class="pt-2 text-center text-xs text-stone-500 font-medium">
                    Don't have an account? 
                    <a href="/signup" class="text-orange-600 hover:text-orange-700 font-semibold underline underline-offset-2 transition-colors">Sign up</a>
                </div>
            </form>
        </div>

        <!-- Right Column: Warm Illustration Panel -->
        <div class="hidden lg:block lg:w-1/2 relative bg-[#F4EFE6] rounded-[1.5rem] overflow-hidden p-5">
            
            <!-- Background Image -->
            <img src="https://images.unsplash.com/photo-1522202176988-66273c2fd55f?q=80&w=1000&auto=format&fit=crop" 
                 alt="Workspace" 
                 class="absolute inset-0 w-full h-full object-cover opacity-40" />
            
            <!-- Overlay Gradient for warmth -->
            <div class="absolute inset-0 bg-gradient-to-t from-[#DBCBAF]/80 via-[#F4EFE6]/40 to-transparent"></div>

            <!-- Overlay Card -->
            <div class="absolute bottom-5 right-5 left-5 bg-white/95 backdrop-blur-md rounded-2xl p-6 shadow-xl shadow-stone-900/5 z-10">
                <div class="flex justify-between items-start mb-3">
                    <h2 class="text-xl font-bold text-stone-900 leading-tight">
                        Pick up where <br>you left off.
                    </h2>
                    <div class="bg-orange-100 text-orange-600 w-8 h-8 flex items-center justify-center rounded-lg">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 3v11.25A2.25 2.25 0 006 16.5h2.25M3.75 3h-1.5m1.5 0h16.5m0 0h1.5m-1.5 0v11.25A2.25 2.25 0 0118 16.5h-2.25m-7.5 0h7.5m-7.5 0l-1 3m8.5-3l1 3m0 0l.5 1.5m-.5-1.5h-9.5m0 0l-.5 1.5M9 11.25v1.5M12 9v3.75m3-6v6"></path>
                        </svg>
                    </div>
                </div>
                
                <div class="flex items-end justify-between">
                    <p class="text-xs text-stone-500 max-w-[80%] font-medium leading-relaxed">
                        Review your upcoming interviews, update application statuses, and keep your job search organized.
                    </p>
                </div>
            </div>
        </div>

    </div>

</body>
</html>
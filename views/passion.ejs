    <style>

        .passion {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 15px;

            min-height: 76px;
            padding: 16px 18px;

            background: white;
            border: 1px solid #e7ddd4;
            border-radius: 18px;

            cursor: pointer;

            transition: all 0.2s ease;
        }


        .passion:hover {
            background: #fcf9f6;
            border-color: #d9c4b7;
            transform: translateY(-1px);
        }


        .passion:has(.passionCheck:checked) {
            background: #f8eee8;
            border-color: #b86f55;
            box-shadow: 0 4px 14px rgba(154, 91, 69, 0.08);
        }


        .role-content {
            display: flex;
            align-items: center;
            gap: 14px;
            min-width: 0;
        }


        .role-icon {
            width: 42px;
            height: 42px;

            flex-shrink: 0;

            display: flex;
            align-items: center;
            justify-content: center;

            border-radius: 13px;

            background: #eee3da;
            color: #8f5845;

            font-size: 10px;
            font-weight: 700;
            letter-spacing: -0.3px;
        }


        .passion h3 {
            font-size: 14px;
            line-height: 1.35;
            font-weight: 600;
            color: #332b27;
        }


        .passionCheck {
            width: 20px;
            height: 20px;

            flex-shrink: 0;

            accent-color: #9a5b45;

            cursor: pointer;
        }


        @media (max-width: 640px) {

            .passion {
                min-height: 70px;
                padding: 14px;
            }

            .role-icon {
                width: 38px;
                height: 38px;
            }

            .passion h3 {
                font-size: 13px;
            }

        }

    </style>


    <script>

        const checkboxes = document.querySelectorAll(".passionCheck");
        const count = document.getElementById("count");
        const search = document.getElementById("search");
        const passions = document.querySelectorAll(".passion");


        // Update selected count
        checkboxes.forEach(checkbox => {

            checkbox.addEventListener("change", () => {

                const selected =
                    document.querySelectorAll(".passionCheck:checked").length;

                count.textContent = selected;

            });

        });


        // Search job roles
        search.addEventListener("input", () => {

            const value = search.value.toLowerCase();

            passions.forEach(passion => {

                const text = passion.textContent.toLowerCase();

                if (text.includes(value)) {

                    passion.style.display = "flex";

                } else {

                    passion.style.display = "none";

                }

            });

        });


        // Clear selections
        function clearAll() {

            checkboxes.forEach(checkbox => {

                checkbox.checked = false;

            });

            count.textContent = "0";

        }

    </script>


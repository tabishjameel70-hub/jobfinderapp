<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Set Up Your Company - JobFinder</title>

    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="min-h-screen bg-[#fffaf5] text-stone-900">

    <!-- Header -->
    <header class="w-full px-6 py-5">
        <div class="max-w-6xl mx-auto flex items-center justify-between">

            <a href="/" class="text-2xl font-extrabold tracking-tight">
                <span class="text-orange-600">Job</span>Finder
            </a>

            <div class="text-sm text-stone-500">
                Recruiter Setup
            </div>

        </div>
    </header>


    <!-- Main -->
    <main class="px-6 py-10">

        <div class="max-w-3xl mx-auto">

            <!-- Progress -->
            <div class="flex items-center justify-center mb-10">

                <div class="flex items-center gap-3">

                    <div class="w-9 h-9 rounded-full bg-orange-600 text-white flex items-center justify-center text-sm font-bold">
                        1
                    </div>

                    <div class="w-16 h-[2px] bg-stone-200"></div>

                    <div class="w-9 h-9 rounded-full bg-stone-200 text-stone-500 flex items-center justify-center text-sm font-bold">
                        2
                    </div>

                    <div class="w-16 h-[2px] bg-stone-200"></div>

                    <div class="w-9 h-9 rounded-full bg-stone-200 text-stone-500 flex items-center justify-center text-sm font-bold">
                        3
                    </div>

                </div>

            </div>


            <!-- Heading -->
            <div class="text-center mb-10">

                <div class="inline-flex items-center justify-center w-14 h-14 rounded-2xl bg-orange-100 text-orange-600 mb-5">

                    <svg xmlns="http://www.w3.org/2000/svg"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke-width="1.8"
                        stroke="currentColor"
                        class="w-7 h-7">

                        <path stroke-linecap="round"
                            stroke-linejoin="round"
                            d="M3.75 21h16.5M4.5 21V5.25A1.5 1.5 0 0 1 6 3.75h6A1.5 1.5 0 0 1 13.5 5.25V21m0 0V8.25A1.5 1.5 0 0 1 15 6.75h3A1.5 1.5 0 0 1 19.5 8.25V21M7.5 7.5h3m-3 3h3m-3 3h3" />

                    </svg>

                </div>

                <h1 class="text-3xl md:text-4xl font-extrab900 tracking-tight">
                    Tell us about your company
                </h1>

                <p class="mt-3 text-stone-500 max-w-xl mx-auto leading-relaxed">
                    Set up your company profile so job seekers can learn more
                    about the organization behind your job postings.
                </p>

            </div>


            <!-- Form Card -->
            <div class="bg-white rounded-[2rem] border border-stone-100 shadow-sm p-6 md:p-10">

                <form action="/company-setup" method="POST" class="space-y-8">


                    <!-- Company Information -->
                    <div>

                        <div class="mb-6">

                            <h2 class="text-lg font-bold text-stone-900">
                                Company Information
                            </h2>

                            <p class="text-sm text-stone-500 mt-1">
                                Basic information about your company.
                            </p>

                        </div>


                        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">


                            <!-- Company Name -->
                            <div class="md:col-span-2">

                                <label for="companyName"
                                    class="block text-sm font-semibold text-stone-700 mb-2">
                                    Company Name
                                </label>

                                <input
                                    type="text"
                                    id="companyName"
                                    name="companyName"
                                    placeholder="e.g. TechNova Solutions"
                                    required
                                    class="w-full px-4 py-3.5 rounded-xl border border-stone-200 bg-stone-50/50
                                    outline-none transition-all
                                    focus:border-orange-500 focus:ring-4 focus:ring-orange-500/10
                                    placeholder:text-stone-400">

                            </div>


                            <!-- Industry -->
                            <div>

                                <label for="industry"
                                    class="block text-sm font-semibold text-stone-700 mb-2">
                                    Industry
                                </label>

                                <select
                                    id="industry"
                                    name="industry"
                                    required
                                    class="w-full px-4 py-3.5 rounded-xl border border-stone-200 bg-stone-50/50
                                    outline-none transition-all
                                    focus:border-orange-500 focus:ring-4 focus:ring-orange-500/10
                                    text-stone-700">

                                    <option value="">Select industry</option>
                                    <option value="Information Technology">Information Technology</option>
                                    <option value="Software">Software</option>
                                    <option value="Artificial Intelligence">Artificial Intelligence</option>
                                    <option value="Cyber Security">Cyber Security</option>
                                    <option value="Fintech">Fintech</option>
                                    <option value="E-commerce">E-commerce</option>
                                    <option value="Education">Education</option>
                                    <option value="Healthcare">Healthcare</option>
                                    <option value="Gaming">Gaming</option>
                                    <option value="Marketing">Marketing</option>
                                    <option value="Other">Other</option>

                                </select>

                            </div>


                            <!-- Company Size -->
                            <div>

                                <label for="companySize"
                                    class="block text-sm font-semibold text-stone-700 mb-2">
                                    Company Size
                                </label>

                                <select
                                    id="companySize"
                                    name="companySize"
                                    required
                                    class="w-full px-4 py-3.5 rounded-xl border border-stone-200 bg-stone-50/50
                                    outline-none transition-all
                                    focus:border-orange-500 focus:ring-4 focus:ring-orange-500/10
                                    text-stone-700">

                                    <option value="">Select company size</option>
                                    <option value="1-10">1–10 employees</option>
                                    <option value="11-50">11–50 employees</option>
                                    <option value="51-200">51–200 employees</option>
                                    <option value="201-500">201–500 employees</option>
                                    <option value="501-1000">501–1,000 employees</option>
                                    <option value="1000+">1,000+ employees</option>

                                </select>

                            </div>


                            <!-- Location -->
                            <div>

                                <label for="location"
                                    class="block text-sm font-semibold text-stone-700 mb-2">
                                    Company Location
                                </label>

                                <input
                                    type="text"
                                    id="location"
                                    name="location"
                                    placeholder="e.g. Karachi, Pakistan"
                                    required
                                    class="w-full px-4 py-3.5 rounded-xl border border-stone-200 bg-stone-50/50
                                    outline-none transition-all
                                    focus:border-orange-500 focus:ring-4 focus:ring-orange-500/10
                                    placeholder:text-stone-400">

                            </div>


                            <!-- Website -->
                            <div>

                                <label for="website"
                                    class="block text-sm font-semibold text-stone-700 mb-2">
                                    Company Website
                                    <span class="font-normal text-stone-400">(Optional)</span>
                                </label>

                                <input
                                    type="url"
                                    id="website"
                                    name="website"
                                    placeholder="https://yourcompany.com"
                                    class="w-full px-4 py-3.5 rounded-xl border border-stone-200 bg-stone-50/50
                                    outline-none transition-all
                                    focus:border-orange-500 focus:ring-4 focus:ring-orange-500/10
                                    placeholder:text-stone-400">

                            </div>

                        </div>

                    </div>


                    <!-- Divider -->
                    <div class="border-t border-stone-100"></div>


                    <!-- Recruiter Information -->
                    <div>

                        <div class="mb-6">

                            <h2 class="text-lg font-bold text-stone-900">
                                Your Position
                            </h2>

                            <p class="text-sm text-stone-500 mt-1">
                                Tell us about your role at the company.
                            </p>

                        </div>


                        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">


                            <!-- Recruiter Name -->
                            <div>

                                <label for="recruiterName"
                                    class="block text-sm font-semibold text-stone-700 mb-2">
                                    Your Name
                                </label>

                                <input
                                    type="text"
                                    id="recruiterName"
                                    name="recruiterName"
                                    placeholder="e.g. Ahmed Khan"
                                    required
                                    class="w-full px-4 py-3.5 rounded-xl border border-stone-200 bg-stone-50/50
                                    outline-none transition-all
                                    focus:border-orange-500 focus:ring-4 focus:ring-orange-500/10
                                    placeholder:text-stone-400">

                            </div>


                            <!-- Job Position -->
                            <div>

                                <label for="position"
                                    class="block text-sm font-semibold text-stone-700 mb-2">
                                    Your Position
                                </label>

                                <select
                                    id="position"
                                    name="position"
                                    required
                                    class="w-full px-4 py-3.5 rounded-xl border border-stone-200 bg-stone-50/50
                                    outline-none transition-all
                                    focus:border-orange-500 focus:ring-4 focus:ring-orange-500/10
                                    text-stone-700">

                                    <option value="">Select your position</option>
                                    <option value="Founder / Co-Founder">Founder / Co-Founder</option>
                                    <option value="HR Manager">HR Manager</option>
                                    <option value="Recruiter">Recruiter</option>
                                    <option value="Hiring Manager">Hiring Manager</option>
                                    <option value="Talent Acquisition">Talent Acquisition</option>
                                    <option value="HR Executive">HR Executive</option>
                                    <option value="Other">Other</option>

                                </select>

                            </div>

                        </div>

                    </div>


                    <!-- Divider -->
                    <div class="border-t border-stone-100"></div>


                    <!-- Company Description -->
                    <div>

                        <label for="description"
                            class="block text-sm font-semibold text-stone-700 mb-2">

                            Company Description

                            <span class="font-normal text-stone-400">
                                (Optional)
                            </span>

                        </label>

                        <textarea
                            id="description"
                            name="description"
                            rows="5"
                            placeholder="Tell job seekers a little about your company..."
                            class="w-full px-4 py-3.5 rounded-xl border border-stone-200 bg-stone-50/50
                            outline-none transition-all resize-none
                            focus:border-orange-500 focus:ring-4 focus:ring-orange-500/10
                            placeholder:text-stone-400"></textarea>

                        <p class="text-xs text-stone-400 mt-2">
                            A short description helps candidates understand your company.
                        </p>

                    </div>


                    <!-- Submit -->
                    <div class="pt-2 flex flex-col-reverse sm:flex-row sm:items-center sm:justify-between gap-4">

                        <a href="/role"
                            class="text-sm font-semibold text-stone-500 hover:text-stone-800 transition-colors text-center">
                            ← Back
                        </a>

                        <button
                            type="submit"
                            class="inline-flex items-center justify-center gap-2
                            px-7 py-3.5 rounded-xl
                            bg-orange-600 text-white
                            font-semibold
                            hover:bg-orange-700
                            active:scale-[0.98]
                            transition-all shadow-sm">

                            Continue to Dashboard

                            <svg xmlns="http://www.w3.org/2000/svg"
                                fill="none"
                                viewBox="0 0 24 24"
                                stroke-width="2"
                                stroke="currentColor"
                                class="w-4 h-4">

                                <path stroke-linecap="round"
                                    stroke-linejoin="round"
                                    d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />

                            </svg>

                        </button>

                    </div>

                </form>

            </div>


            <!-- Footer Note -->
            <p class="text-center text-xs text-stone-400 mt-6">
                You can update your company information later from your recruiter dashboard.
            </p>

        </div>

    </main>

</body>

</html>
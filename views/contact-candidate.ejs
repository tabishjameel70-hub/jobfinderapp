
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Contact Candidate | JobFinder</title>

    <script src="https://cdn.tailwindcss.com"></script>

    <link
        href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
        rel="stylesheet">
</head>

<body class="min-h-screen bg-[#fffaf5] text-stone-800"
    style="font-family: 'Plus Jakarta Sans', sans-serif;">

    <!-- Navbar -->
    <nav class="border-b border-orange-100 bg-white">
        <div class="mx-auto flex max-w-6xl items-center justify-between px-6 py-5">

            <a href="/" class="text-2xl font-extrabold tracking-tight text-orange-500">
                JobFinder
            </a>

            <div class="flex items-center gap-6 text-sm font-semibold">
                <a href="/recruiter-home"
                    class="text-stone-600 transition hover:text-orange-500">
                    Dashboard
                </a>

                <a href="/candidates"
                    class="text-stone-600 transition hover:text-orange-500">
                    Candidates
                </a>

                <a href="/profile"
                    class="text-stone-600 transition hover:text-orange-500">
                    Profile
                </a>
            </div>

        </div>
    </nav>


    <!-- Main -->
    <main class="mx-auto max-w-4xl px-6 py-12">

        <!-- Back -->
        <a href="/candidates/<%= candidate._id %>"
            class="mb-8 inline-flex items-center gap-2 text-sm font-semibold text-stone-500 transition hover:text-orange-500">
            ← Back to Candidate
        </a>


        <!-- Contact Card -->
        <div class="overflow-hidden rounded-3xl border border-orange-100 bg-white shadow-sm">

            <!-- Orange Header -->
            <div class="bg-gradient-to-r from-orange-400 to-orange-500 px-8 py-10">

                <div class="flex items-center gap-5">

                    <!-- Avatar -->
                    <div
                        class="flex h-20 w-20 items-center justify-center rounded-2xl border-4 border-white/80 bg-orange-100 text-3xl font-extrabold text-orange-600 shadow-lg">

                        <%= candidate.username.charAt(0).toUpperCase() %>

                    </div>

                    <div class="text-white">

                        <h1 class="text-3xl font-extrabold">
                            Contact <%= candidate.username %>
                        </h1>

                        <p class="mt-1 text-orange-50">
                            <%= candidate.passion || "Job Seeker" %>
                        </p>

                    </div>

                </div>

            </div>


            <!-- Form Section -->
            <div class="p-8 sm:p-10">

                <div class="mb-8">

                    <h2 class="text-2xl font-extrabold text-stone-900">
                        Start a Conversation
                    </h2>

                    <p class="mt-2 text-sm leading-6 text-stone-500">
                        Reach out to <%= candidate.username %> about a potential
                        job opportunity at your company.
                    </p>

                </div>


                <!-- Contact Form -->
                <form action="/contact-candidate/<%= candidate._id %>"
                    method="POST"
                    class="space-y-6">


                    <!-- Candidate Email -->
                    <div>

                        <label class="mb-2 block text-sm font-bold text-stone-700">
                            Candidate Email
                        </label>

                        <input
                            type="email"
                            value="<%= candidate.email %>"
                            readonly
                            class="w-full rounded-xl border border-orange-100 bg-[#fffaf5] px-4 py-3.5 text-sm text-stone-600 outline-none">

                    </div>


                    <!-- Subject -->
                    <div>

                        <label
                            for="subject"
                            class="mb-2 block text-sm font-bold text-stone-700">
                            Subject
                        </label>

                        <input
                            type="text"
                            id="subject"
                            name="subject"
                            required
                            placeholder="Backend Developer Opportunity"
                            class="w-full rounded-xl border border-orange-100 bg-white px-4 py-3.5 text-sm text-stone-800 outline-none transition placeholder:text-stone-400 focus:border-orange-400 focus:ring-2 focus:ring-orange-100">

                    </div>


                    <!-- Message -->
                    <div>

                        <label
                            for="message"
                            class="mb-2 block text-sm font-bold text-stone-700">
                            Message
                        </label>

                        <textarea
                            id="message"
                            name="message"
                            rows="8"
                            required
                            placeholder="Hi <%= candidate.username %>,

We came across your profile and think you could be a great fit for a position at our company.

We would love to discuss the opportunity with you."
                            class="w-full resize-none rounded-xl border border-orange-100 bg-white px-4 py-3.5 text-sm leading-6 text-stone-800 outline-none transition placeholder:text-stone-400 focus:border-orange-400 focus:ring-2 focus:ring-orange-100"></textarea>

                    </div>


                    <!-- Info -->
                    <div class="flex gap-3 rounded-xl border border-orange-100 bg-[#fffaf5] p-4">

                        <div class="mt-0.5 text-orange-500">
                            ✉
                        </div>

                        <div>

                            <p class="text-sm font-bold text-stone-800">
                                Keep it professional
                            </p>

                            <p class="mt-1 text-xs leading-5 text-stone-500">
                                Introduce your company, explain the opportunity,
                                and let the candidate know how they can respond.
                            </p>

                        </div>

                    </div>


                    <!-- Buttons -->
                    <div class="flex flex-col-reverse gap-3 pt-3 sm:flex-row sm:justify-end">

                        <a href="/candidates/<%= candidate._id %>"
                            class="rounded-xl border border-stone-200 px-6 py-3 text-center text-sm font-bold text-stone-600 transition hover:bg-stone-50">
                            Cancel
                        </a>

                        <button
                            type="submit"
                            class="rounded-xl bg-orange-500 px-7 py-3 text-sm font-bold text-white shadow-sm transition hover:bg-orange-600 hover:shadow-md">
                            Send Message →
                        </button>

                    </div>

                </form>

            </div>

        </div>

    </main>

</body>

</html>


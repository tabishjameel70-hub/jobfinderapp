
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Job Details | JobFinder</title>

    <script src="https://cdn.tailwindcss.com"></script>

    <link
        href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
        rel="stylesheet">
</head>

<body class="min-h-screen bg-[#fffaf5] text-stone-800">

    <!-- Navbar -->
    <nav class="border-b border-orange-100 bg-white">
        <div class="max-w-7xl mx-auto px-6 py-5 flex items-center justify-between">

            <h1  class="text-2xl font-extrabold text-orange-500">
                JobFinder
            </h1>

            <div class="flex items-center gap-6">

                <a href="/recruiter-home" class="text-sm font-medium text-stone-600 hover:text-orange-500">
                    Home
                </a>
                <a href="/profile"
                    class="px-5 py-2.5 rounded-xl bg-orange-500 text-white text-sm font-semibold hover:bg-orange-600">
                    Profile
                </a>

            </div>

        </div>
    </nav>


    <!-- Main -->
    <main class="max-w-5xl mx-auto px-6 py-12">

        <!-- Back -->
        <a href="/recruiter-home"
            class="inline-flex items-center gap-2 text-sm font-semibold text-orange-500 hover:text-orange-600 mb-8">
            ← Back to My Jobs
        </a>


 <!-- Job Header -->
<div class="bg-white border border-orange-100 rounded-3xl p-8 md:p-10 shadow-sm">

    <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-6">

        <div class="flex items-start gap-5">

            <!-- Company Image / Icon -->
            <div class="w-20 h-20 shrink-0 rounded-2xl bg-orange-100
                        flex items-center justify-center overflow-hidden">

                <% if (jobs.company && jobs.company.image) { %>

                    <img
                        src="/uploads/company/<%= jobs.company.image %>"
                        alt="<%= jobs.firmName %>"
                        class="w-full h-full object-cover"
                    >

                <% } else { %>

                    <!-- Default image icon -->
                    <svg
                        class="w-10 h-10 text-orange-500"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24">

                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="1.8"
                            d="M3 7.5A2.5 2.5 0 015.5 5h4l2 2h7A2.5 2.5 0 0121 9.5v8A2.5 2.5 0 0118.5 20h-13A2.5 2.5 0 013 17.5v-10z" />

                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="1.8"
                            d="M8 15l2.5-2.5 2 2 1.5-1.5L17 16" />

                    </svg>

                <% } %>

            </div>


            <!-- Job Information -->
            <div>

                <p class="text-sm font-semibold text-orange-500 mb-3">
                    JOB DETAILS
                </p>

                <h1 class="text-4xl font-extrabold text-stone-900">
                    <%= jobs.title %>
                </h1>

                <p class="mt-3 text-lg text-stone-500">
                    <%= jobs.firmName %>
                </p>

            </div>

        </div>


        <!-- Job Type -->
        <span
            class="w-fit px-4 py-2 rounded-full bg-orange-50 text-orange-600 text-sm font-semibold">

            <%= jobs.jobType %>

        </span>

    </div>

    </main>

</body>

</html>


<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Job Details | JobFinder</title>

    <script src="https://cdn.tailwindcss.com"></script>

    <link
        href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
        rel="stylesheet">
</head>

<body class="min-h-screen bg-[#fffaf5] text-stone-800">

    <!-- Navbar -->
    <nav class="border-b border-orange-100 bg-white">
        <div class="max-w-7xl mx-auto px-6 py-5 flex items-center justify-between">

            <h1  class="text-2xl font-extrabold text-orange-500">
                JobFinder
            </h1>

            <div class="flex items-center gap-6">

                <a href="/recruiter-home" class="text-sm font-medium text-stone-600 hover:text-orange-500">
                    Home
                </a>
                <a href="/profile"
                    class="px-5 py-2.5 rounded-xl bg-orange-500 text-white text-sm font-semibold hover:bg-orange-600">
                    Profile
                </a>

            </div>

        </div>
    </nav>


    <!-- Main -->
    <main class="max-w-5xl mx-auto px-6 py-12">

        <!-- Back -->
        <a href="/recruiter-home"
            class="inline-flex items-center gap-2 text-sm font-semibold text-orange-500 hover:text-orange-600 mb-8">
            ← Back to My Jobs
        </a>


        <!-- Job Header -->
        <div class="bg-white border border-orange-100 rounded-3xl p-8 md:p-10 shadow-sm">

            <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-6">

                <div>

                    <p class="text-sm font-semibold text-orange-500 mb-3">
                        JOB DETAILS
                    </p>

                    <h1 class="text-4xl font-extrabold text-stone-900">
                        <%= jobs.title %>
                    </h1>

                    <p class="mt-3 text-lg text-stone-500">
                        <%= jobs.firmName %>
                    </p>

                </div>


                <span
                    class="w-fit px-4 py-2 rounded-full bg-orange-50 text-orange-600 text-sm font-semibold">
                    <%= jobs.jobType %>
                </span>

            </div>


            <!-- Job Information -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-5 mt-10">

                <!-- Location -->
                <div class="flex items-center gap-4 p-5 rounded-2xl bg-[#fffaf5]">

                    <div class="text-2xl">
                        📍
                    </div>

                    <div>

                        <p class="text-xs font-semibold text-stone-400 uppercase">
                            Location
                        </p>

                        <p class="mt-1 font-semibold text-stone-800">
                            <%= jobs.location %>
                        </p>

                    </div>

                </div>


                <!-- Workplace -->
                <div class="flex items-center gap-4 p-5 rounded-2xl bg-[#fffaf5]">

                    <div class="text-2xl">
                        💼
                    </div>

                    <div>

                        <p class="text-xs font-semibold text-stone-400 uppercase">
                            Workplace
                        </p>

                        <p class="mt-1 font-semibold text-stone-800">
                            <%= jobs.workplace %>
                        </p>

                    </div>

                </div>


                <!-- Category -->
                <div class="flex items-center gap-4 p-5 rounded-2xl bg-[#fffaf5]">

                    <div class="text-2xl">
                        🏷️
                    </div>

                    <div>

                        <p class="text-xs font-semibold text-stone-400 uppercase">
                            Category
                        </p>

                        <p class="mt-1 font-semibold text-stone-800">
                            <%= jobs.category %>
                        </p>

                    </div>

                </div>


                <!-- Salary -->
                <div class="flex items-center gap-4 p-5 rounded-2xl bg-[#fffaf5]">

                    <div class="text-2xl">
                        💰
                    </div>

                    <div>

                        <p class="text-xs font-semibold text-stone-400 uppercase">
                            Salary
                        </p>

                        <p class="mt-1 font-semibold text-stone-800">
                            Rs. <%= jobs.salary %> - Rs. <%= jobs.salaryMax %>
                        </p>

                    </div>

                </div>

            </div>


            <!-- Description -->
            <div class="mt-10">

                <h2 class="text-2xl font-bold text-stone-900">
                    Job Description
                </h2>

                <p class="mt-4 text-stone-600 leading-8">
                    <%= jobs.description %>
                </p>

            </div>


            <!-- Company -->
            <div class="mt-10 pt-10 border-t border-orange-100">

                <h2 class="text-2xl font-bold text-stone-900">
                    Company
                </h2>

                <div class="mt-5 p-6 rounded-2xl bg-[#fffaf5]">

                    <h3 class="text-xl font-bold text-stone-900">
                        <%= jobs.firmName %>
                    </h3>

                    <p class="mt-2 text-stone-500">
                        <%= jobs.category %>
                    </p>

                    <p class="mt-4 text-sm text-stone-600">
                        <%= jobs.location %>
                    </p>

                </div>

            </div>


            <!-- Actions -->
            <div class="mt-10 flex flex-col sm:flex-row gap-4">

                <a href="/recruiter-home"
                    class="px-6 py-3 rounded-xl border border-orange-200 text-orange-600 font-semibold text-center hover:bg-orange-50">
                    Back to My Jobs
                </a>
            </div>

        </div>

    </main>

</body>

</html>

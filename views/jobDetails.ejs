```html
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Jobs - JobFinder</title>

    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="min-h-screen bg-[#fffaf5] text-stone-800">

    <!-- Navbar -->
    <nav class="bg-white border-b border-orange-100">
        <div class="max-w-6xl mx-auto px-6 py-5 flex justify-between items-center">


            <a href="/recruiter-home" class="text-stone-600 hover:text-orange-500">
                Home
            </a>

        </div>
    </nav>


    <!-- Main -->
    <main class="max-w-6xl mx-auto px-6 py-10">

        <div class="mb-8">
            <h1 class="text-3xl font-bold text-stone-900">
                Available Jobs
            </h1>

            <p class="mt-2 text-stone-500">
                Find your next technical opportunity.
            </p>
        </div>


        <!-- Jobs -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">

            <% jobs.forEach(job => { %>

                <div
                    class="bg-white rounded-3xl border border-orange-100 p-7 shadow-sm hover:shadow-md transition">

                    <!-- Header -->
                    <div class="flex justify-between items-start gap-4">

                        <div>
    <span
                                class="inline-block px-3 py-1 rounded-full bg-orange-50 text-orange-600 text-xs font-semibold">
                                <%= job.companyNa %>
                            </span>

                            <span
                                class="inline-block px-3 py-1 rounded-full bg-orange-50 text-orange-600 text-xs font-semibold">
                                <%= job.category %>
                            </span>

                            <h2 class="mt-4 text-2xl font-bold text-stone-900">
                                <%= job.title %>
                            </h2>

                        </div>

                        <span
                            class="px-3 py-1 rounded-full bg-green-50 text-green-600 text-xs font-semibold whitespace-nowrap">
                            <%= job.jobType %>
                        </span>

                    </div>


                    <!-- Job Details -->
                    <div class="mt-6 space-y-4">

                        <!-- Location -->
                        <div class="flex items-center gap-3">

                            <div
                                class="w-10 h-10 rounded-xl bg-orange-50 flex items-center justify-center">
                                📍
                            </div>

                            <div>
                                <p class="text-xs text-stone-400">
                                    Location
                                </p>

                                <p class="font-medium text-stone-700">
                                    <%= job.location %>
                                </p>
                            </div>

                        </div>


                        <!-- Workplace -->
                        <div class="flex items-center gap-3">

                            <div
                                class="w-10 h-10 rounded-xl bg-orange-50 flex items-center justify-center">
                                🏢
                            </div>

                            <div>
                                <p class="text-xs text-stone-400">
                                    Workplace
                                </p>

                                <p class="font-medium text-stone-700">
                                    <%= job.workplace %>
                                </p>
                            </div>

                        </div>


                        <!-- Salary -->
                        <div class="flex items-center gap-3">

                            <div
                                class="w-10 h-10 rounded-xl bg-orange-50 flex items-center justify-center">
                                💰
                            </div>

                            <div>
                                <p class="text-xs text-stone-400">
                                    Salary
                                </p>

                                <p class="font-medium text-stone-700">

                                    <% if (job.salaryMax) { %>

                                        Rs. <%= job.salary %> -
                                        Rs. <%= job.salaryMax %>

                                    <% } else { %>

                                        Rs. <%= job.salary %>

                                    <% } %>

                                </p>

                            </div>

                        </div>

                    </div>


                    <!-- Description -->
                    <div class="mt-6 pt-6 border-t border-stone-100">

                        <p class="text-sm text-stone-500 leading-6 line-clamp-3">
                            <%= job.description %>
                        </p>

                    </div>


                    <!-- Button -->
                    <div class="mt-6">

                        <a href="/job-details/<%= job._id %>"
                            class="block w-full text-center py-3 rounded-xl bg-orange-500 hover:bg-orange-600 text-white font-semibold transition">

                            View Job Details

                        </a>

                    </div>

                </div>

            <% }) %>

        </div>

    </main>

</body>

</html>
```

```html
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>My Jobs | JobFinder</title>

    <script src="https://cdn.tailwindcss.com"></script>

    <link
        href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
        rel="stylesheet">
</head>

<body class="min-h-screen bg-[#fffaf5] text-stone-800">

    <!-- Navbar -->
    <nav class="border-b border-orange-100 bg-white">
        <div class="max-w-7xl mx-auto px-6 py-5 flex items-center justify-between">

            <a href="/" class="text-2xl font-extrabold text-orange-500">
                JobFinder
            </a>

            <div class="flex items-center gap-6">

                <a href="/recruiter-home" class="text-sm font-medium text-stone-600 hover:text-orange-500">
                    Home
                </a>

                <a href="/jobs" class="text-sm font-medium text-stone-600 hover:text-orange-500">
                    Jobs
                </a>

                <a href="/profile"
                    class="px-5 py-2.5 rounded-xl bg-orange-500 text-white text-sm font-semibold hover:bg-orange-600">
                    Profile
                </a>

            </div>

        </div>
    </nav>


    <!-- Main -->
    <main class="max-w-7xl mx-auto px-6 py-12">

        <!-- Heading -->
        <div class="mb-10">

            <p class="text-sm font-semibold text-orange-500 mb-2">
                YOUR JOBS
            </p>

            <h1 class="text-4xl font-extrabold text-stone-900">
                My Jobs
            </h1>

            <p class="mt-3 text-stone-500">
                Jobs you have applied for.
            </p>

        </div>


        <!-- Job Cards -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">

            <% jobs.forEach(function(job) { %>

                <!-- Job Card -->
                <div class="bg-white border border-orange-100 rounded-2xl p-6 shadow-sm hover:shadow-md transition">

                    <div class="flex items-start justify-between gap-4">

                        <div>

                            <h2 class="text-xl font-bold text-stone-900">
                                <%= job.title %>
                            </h2>

                            <p class="mt-1 text-sm text-stone-500">
                                <%= job.firmName %>
                            </p>

                        </div>

                        <span class="px-3 py-1 rounded-full bg-orange-50 text-orange-600 text-xs font-semibold">
                            <%= job.jobType %>
                        </span>

                    </div>


                    <div class="mt-6 space-y-3">

                        <!-- Location -->
                        <div class="flex items-center gap-3 text-sm text-stone-600">

                            <span class="text-orange-500">
                                📍
                            </span>

                            <span>
                                <%= job.location %>
                            </span>

                        </div>


                        <!-- Workplace -->
                        <div class="flex items-center gap-3 text-sm text-stone-600">

                            <span class="text-orange-500">
                                💼
                            </span>

                            <span>
                                <%= job.workplace %>
                            </span>

                        </div>


                        <!-- Category -->
                        <div class="flex items-center gap-3 text-sm text-stone-600">

                            <span class="text-orange-500">
                                🏷️
                            </span>

                            <span>
                                <%= job.category %>
                            </span>

                        </div>


                        <!-- Salary -->
                        <div class="flex items-center gap-3 text-sm text-stone-600">

                            <span class="text-orange-500">
                                💰
                            </span>

                            <span>
                                Rs. <%= job.salary %> - Rs. <%= job.salaryMax %>
                            </span>

                        </div>

                    </div>


                    <!-- Description -->
                    <p class="mt-6 text-sm text-stone-500 leading-6">
                        <%= job.description %>
                    </p>


                    <!-- Button -->
                    <div class="mt-6">

                        <a href="/jobDetails/<%= job._id %>"
                            class="block w-full text-center px-5 py-3 rounded-xl bg-orange-500 text-white font-semibold text-sm hover:bg-orange-600 transition">

                            View Job

                        </a>

                    </div>

                </div>

            <% }) %>

        </div>

    </main>

</body>

</html>

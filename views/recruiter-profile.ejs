<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>
        <%= recruiter.companyName %> - JobFinder
    </title>

    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="min-h-screen bg-[#fffaf5] text-stone-900">

 <!-- Navbar --> <nav class="bg-white border-b border-stone-200"> <div class="max-w-6xl mx-auto px-6 py-5 flex items-center justify-between"> <a href="/" class="text-2xl font-extrabold tracking-tight"> <span class="text-orange-600">Job</span>Finder </a> <div class="flex items-center gap-5"> <a href="/jobs" class="text-sm font-semibold text-stone-600 hover:text-orange-600 transition"> Browse Jobs </a> <a href="/logout" class="px-5 py-2.5 rounded-xl bg-orange-500 text-white text-sm font-semibold hover:bg-orange-600 transition"> Logout </a> </div> </div> </nav>


    <!-- Main -->
    <main class="max-w-5xl mx-auto px-6 py-10">


        <!-- Profile Header -->
        <section class="bg-white rounded-[2rem] border border-stone-100 shadow-sm overflow-hidden">

            <!-- Cover -->
            <div class="h-40 bg-gradient-to-r from-orange-500 to-amber-300"></div>


            <div class="px-6 md:px-10 pb-10">

                <!-- Company Logo -->
                <div class="-mt-12 mb-6">

                    <div class="w-24 h-24 rounded-3xl bg-stone-900
                                border-4 border-white shadow-md
                                flex items-center justify-center
                                text-white text-3xl font-extrabold">

                        <%= recruiter.companyName ? recruiter.companyName.charAt(0).toUpperCase() : 'C' %>

                    </div>

                </div>


                <!-- Company Name -->
                <div>

                    <h1 class="text-3xl md:text-4xl font-extrabold tracking-tight">
                        <%= recruiter.companyName %>
                    </h1>

                    <p class="mt-2 text-stone-500 text-lg">
                        <%= recruiter.industry %>
                    </p>

                </div>


                <!-- Quick Information -->
                <div class="flex flex-wrap gap-3 mt-6">

                    <!-- Location -->
                    <div class="inline-flex items-center gap-2
                                px-4 py-2 rounded-full
                                bg-stone-100 text-stone-600 text-sm">

                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8"
                            stroke="currentColor" class="w-4 h-4">

                            <path stroke-linecap="round" stroke-linejoin="round"
                                d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />

                            <path stroke-linecap="round" stroke-linejoin="round"
                                d="M19.5 10.5c0 7.142-7.5 10.5-7.5 10.5S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z" />

                        </svg>

                        <%= recruiter.location %>

                    </div>


                    <!-- Company Size -->
                    <div class="inline-flex items-center gap-2
                                px-4 py-2 rounded-full
                                bg-stone-100 text-stone-600 text-sm">

                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8"
                            stroke="currentColor" class="w-4 h-4">

                            <path stroke-linecap="round" stroke-linejoin="round"
                                d="M18 18.72a9.094 9.094 0 0 0 3.742-.479 3 3 0 0 0-4.682-2.72m.94 3.198v.75A7.5 7.5 0 0 1 15 21.75H9a7.5 7.5 0 0 1-7.5-7.5v-.75m16.94 3.198a9.094 9.094 0 0 1-3.742-.479 3 3 0 0 1 4.682-2.72m-7.88 3.198a9.094 9.094 0 0 1-3.742-.479 3 3 0 0 1 4.682-2.72" />

                        </svg>

                        <%= recruiter.companySize %>

                    </div>


                    <!-- Industry -->
                    <div class="inline-flex items-center gap-2
                                px-4 py-2 rounded-full
                                bg-orange-50 text-orange-700 text-sm">

                        <%= recruiter.industry %>

                    </div>

                </div>

            </div>

        </section>


        <!-- Details -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mt-6">


            <!-- About -->
            <section class="lg:col-span-2 bg-white
                            rounded-[1.75rem]
                            border border-stone-100
                            shadow-sm p-7 md:p-8">

                <h2 class="text-xl font-bold mb-5">
                    About <%= recruiter.companyName %>
                </h2>

                <% if (recruiter.description) { %>

                    <p class="text-stone-600 leading-7">
                        <%= recruiter.description %>
                    </p>

                    <% } else { %>

                        <p class="text-stone-400">
                            This company hasn't added a description yet.
                        </p>

                        <% } %>

            </section>


            <!-- Company Details -->
            <section class="bg-white
                            rounded-[1.75rem]
                            border border-stone-100
                            shadow-sm p-7 md:p-8">

                <h2 class="text-xl font-bold mb-6">
                    Company Details
                </h2>


                <div class="space-y-6">


                    <!-- Industry -->
                    <div>

                        <p class="text-xs uppercase tracking-wider
                                  font-semibold text-stone-400">
                            Industry
                        </p>

                        <p class="mt-1 font-semibold">
                            <%= recruiter.industry %>
                        </p>

                    </div>


                    <!-- Size -->
                    <div>

                        <p class="text-xs uppercase tracking-wider
                                  font-semibold text-stone-400">
                            Company Size
                        </p>

                        <p class="mt-1 font-semibold">
                            <%= recruiter.companySize %>
                        </p>

                    </div>


                    <!-- Location -->
                    <div>

                        <p class="text-xs uppercase tracking-wider
                                  font-semibold text-stone-400">
                            Location
                        </p>

                        <p class="mt-1 font-semibold">
                            <%= recruiter.location %>
                        </p>

                    </div>


                    <!-- Website -->
                    <div>

                        <p class="text-xs uppercase tracking-wider
                                  font-semibold text-stone-400">
                            Website
                        </p>

                        <% if (recruiter.website) { %>

                            <a href="<%= recruiter.website %>" target="_blank" class="mt-1 inline-block text-orange-600
                                       font-semibold hover:text-orange-700
                                       break-all">

                                Visit Website →

                            </a>

                            <% } else { %>

                                <p class="mt-1 text-stone-400">
                                    Not provided
                                </p>

                                <% } %>

                    </div>

                </div>

            </section>


            <!-- Recruiter -->
            <section class="lg:col-span-3 bg-white
                            rounded-[1.75rem]
                            border border-stone-100
                            shadow-sm p-7 md:p-8">

                <h2 class="text-xl font-bold mb-6">
                    Contact Person
                </h2>

                <a href="/logout" class="text-xl font-bold mb-6">
                    Contact Person
                </a>
                <div class="flex items-center gap-5">

                    <!-- Avatar -->
                    <div class="w-16 h-16 rounded-2xl
                                bg-orange-100 text-orange-700
                                flex items-center justify-center
                                text-xl font-bold">

                        <%= recruiter.recruiterName ? recruiter.recruiterName.charAt(0).toUpperCase() : 'R' %>

                    </div>


                    <div>

                        <h3 class="font-bold text-lg">
                            <%= recruiter.recruiterName %>
                        </h3>

                        <p class="text-stone-500 mt-1">
                            <%= recruiter.position %>
                        </p>

                    </div>

                </div>

            </section>

        </div>

    </main>

</body>

</html>
```html
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Apply for Job - JobFinder</title>

    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="min-h-screen bg-[#fffaf5] text-stone-800">

    <!-- Navbar -->
    <nav class="border-b border-orange-100 bg-white">
        <div class="max-w-6xl mx-auto px-6 py-5 flex items-center justify-between">

            <a href="/jobs" class="text-2xl font-bold text-orange-500">
                JobFinder
            </a>

            <a href="/jobs"
                class="text-sm font-semibold text-stone-600 hover:text-orange-500 transition">
                ← Back to Jobs
            </a>

        </div>
    </nav>


    <!-- Main -->
    <main class="max-w-4xl mx-auto px-6 py-10">

        <!-- Page Header -->
        <div class="mb-8">

            <p class="text-sm font-semibold text-orange-500 uppercase tracking-wider">
                Job Application
            </p>

            <h1 class="text-3xl md:text-4xl font-bold text-stone-900 mt-2">
                Apply for this position
            </h1>

            <p class="mt-3 text-stone-500">
                Complete the form below to submit your application.
            </p>

        </div>


        <!-- Job Summary -->
        <section class="bg-white border border-orange-100
                        rounded-3xl shadow-sm p-6 md:p-8 mb-6">

            <div class="flex items-center gap-4">

                <div class="w-14 h-14 rounded-2xl bg-orange-100
                            flex items-center justify-center
                            text-orange-500 text-xl font-bold">

                    <%= jobs.title
                        ? jobs.title.charAt(0).toUpperCase()
                        : "J"
                    %>

                </div>

                <div>

                    <h2 class="text-xl font-bold text-stone-900">
                        <%= jobs.title %>
                    </h2>

                    <% if (jobs.company) { %>

                        <p class="text-orange-500 font-medium mt-1">
                            <%= jobs.company.companyName %>
                        </p>

                    <% } %>

                </div>

            </div>

        </section>


        <!-- Candidate Profile -->
        <section class="bg-white border border-orange-100
                        rounded-3xl shadow-sm p-6 md:p-8 mb-6">

            <h2 class="text-xl font-bold text-stone-900 mb-5">
                Applying as
            </h2>

            <div class="flex items-center gap-4">

                <!-- Profile Image -->
                <div class="w-16 h-16 rounded-2xl overflow-hidden
                            bg-orange-100 border border-orange-200
                            flex items-center justify-center
                            text-orange-600 text-2xl font-bold">

                    <% if (user.profileImage) { %>

                        <img
                            src="/uploads/profile/<%= user.profileImage %>"
                            alt="<%= user.username %>"
                            class="w-full h-full object-cover">

                    <% } else { %>

                        <%= user.username
                            ? user.username.charAt(0).toUpperCase()
                            : "U"
                        %>

                    <% } %>

                </div>


                <!-- User Information -->
                <div>

                    <h3 class="text-lg font-bold text-stone-900">
                        <%= user.username || "Unknown User" %>
                    </h3>

                    <p class="text-sm text-stone-500 mt-1">
                        <%= user.email || "No email available" %>
                    </p>

                </div>

            </div>

        </section>


        <!-- Application Form -->
        <form
            action="/apply/<%= jobs._id %>"
            method="POST"
            enctype="multipart/form-data"
            class="bg-white border border-orange-100
                   rounded-3xl shadow-sm p-6 md:p-8">


            <h2 class="text-2xl font-bold text-stone-900 mb-7">
                Your Information
            </h2>


            <!-- Name -->
            <div class="mb-6">

                <label class="block text-sm font-semibold text-stone-700 mb-2">
                    Full Name
                </label>

                <input
                    type="text"
                    name="name"
                    value="<%= user.username || '' %>"
                    placeholder="Enter your full name"
                    required
                    class="w-full px-4 py-3 rounded-xl
                           border border-stone-200
                           focus:outline-none focus:ring-2
                           focus:ring-orange-400
                           focus:border-transparent">

            </div>


            <!-- Email -->
            <div class="mb-6">

                <label class="block text-sm font-semibold text-stone-700 mb-2">
                    Email
                </label>

                <input
                    type="email"
                    name="email"
                    value="<%= user.email || '' %>"
                    placeholder="Enter your email"
                    required
                    class="w-full px-4 py-3 rounded-xl
                           border border-stone-200
                           focus:outline-none focus:ring-2
                           focus:ring-orange-400
                           focus:border-transparent">

            </div>


            <!-- Phone -->
            <div class="mb-6">

                <label class="block text-sm font-semibold text-stone-700 mb-2">
                    Phone Number
                </label>

                <input
                    type="tel"
                    name="phone"
                    placeholder="Enter your phone number"
                    class="w-full px-4 py-3 rounded-xl
                           border border-stone-200
                           focus:outline-none focus:ring-2
                           focus:ring-orange-400
                           focus:border-transparent">

            </div>


            <!-- Resume -->
            <div class="mb-6">

                <label class="block text-sm font-semibold text-stone-700 mb-2">
                    Resume
                </label>

                <input
                    type="file"
                    name="resume"
                    accept=".pdf,.doc,.docx"
                    required
                    class="w-full px-4 py-3 rounded-xl
                           border border-stone-200
                           bg-white
                           text-stone-600
                           file:mr-4
                           file:py-2
                           file:px-4
                           file:rounded-lg
                           file:border-0
                           file:bg-orange-50
                           file:text-orange-600
                           file:font-semibold">

                <p class="text-xs text-stone-400 mt-2">
                    PDF, DOC, or DOCX
                </p>

            </div>


            <!-- Cover Letter -->
            <div class="mb-8">

                <label class="block text-sm font-semibold text-stone-700 mb-2">
                    Cover Letter
                </label>

                <textarea
                    name="coverLetter"
                    rows="7"
                    placeholder="Tell the recruiter why you are a good fit for this position..."
                    class="w-full px-4 py-3 rounded-xl
                           border border-stone-200
                           resize-none
                           focus:outline-none
                           focus:ring-2
                           focus:ring-orange-400
                           focus:border-transparent"></textarea>

            </div>


            <!-- Submit -->
            <button
                type="submit"
                class="w-full py-3.5 rounded-xl
                       bg-orange-500 text-white
                       font-semibold
                       hover:bg-orange-600
                       transition">

                Submit Application →

            </button>


            <p class="text-center text-xs text-stone-400 mt-4">
                Make sure your information is correct before submitting.
            </p>

        </form>

    </main>

</body>

</html>
```

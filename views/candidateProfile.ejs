
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Candidate Profile - JobFinder</title>

    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="min-h-screen bg-[#fffaf5] text-stone-800">

    <!-- Navbar -->
    <nav class="bg-white border-b border-orange-100">
        <div class="max-w-7xl mx-auto px-6 py-5 flex items-center justify-between">

            <a href="/" class="text-2xl font-bold text-orange-500">
                JobFinder
            </a>

            <a href="/candidates"
                class="px-5 py-2.5 rounded-xl bg-orange-500 text-white font-semibold hover:bg-orange-600 transition">
                Back to Candidates
            </a>

        </div>
    </nav>


    <!-- Main -->
    <main class="max-w-4xl mx-auto px-6 py-12">

        <!-- Profile Card -->
        <div class="bg-white rounded-3xl border border-orange-100 shadow-sm overflow-hidden">

            <!-- Cover -->
            <div class="h-36 bg-gradient-to-r from-orange-400 to-orange-500"></div>


            <!-- Content -->
            <div class="px-6 md:px-10 pb-10">

                <!-- Avatar -->
                <div class="-mt-14">

                    <div
                        class="w-28 h-28 rounded-3xl bg-orange-100 border-4 border-white shadow-lg flex items-center justify-center text-4xl font-bold text-orange-600">

                        <%= candidate.username
                            ? candidate.username.charAt(0).toUpperCase()
                            : "U" %>

                    </div>

                </div>


                <!-- Name -->
                <div class="mt-5">

                    <h1 class="text-3xl font-bold text-stone-900">
                        <%= candidate.username || "Unknown User" %>
                    </h1>

                    <p class="text-stone-500 mt-1">
                        Job Seeker
                    </p>

                </div>


                <!-- Candidate Information -->
                <div class="mt-10">

                    <h2 class="text-xl font-bold text-stone-900 mb-5">
                        Candidate Information
                    </h2>


                    <div class="grid grid-cols-1 md:grid-cols-2 gap-5">

                        <!-- Username -->
                        <div class="bg-[#fffaf5] border border-orange-100 rounded-2xl p-5">

                            <p class="text-xs uppercase font-semibold text-stone-400">
                                Username
                            </p>

                            <p class="mt-2 text-lg font-semibold text-stone-800">
                                <%= candidate.username || "Not provided" %>
                            </p>

                        </div>


                        <!-- Email -->
                        <div class="bg-[#fffaf5] border border-orange-100 rounded-2xl p-5">

                            <p class="text-xs uppercase font-semibold text-stone-400">
                                Email
                            </p>

                            <p class="mt-2 text-lg font-semibold text-stone-800 break-all">
                                <%= candidate.email || "Not provided" %>
                            </p>

                        </div>


                        <!-- Passion -->
                        <div class="bg-[#fffaf5] border border-orange-100 rounded-2xl p-5">

                            <p class="text-xs uppercase font-semibold text-stone-400">
                                Passion
                            </p>

                            <p class="mt-2 text-lg font-semibold text-orange-500">
                                <%= candidate.passion || "Not selected" %>
                            </p>

                        </div>


                        <!-- Role -->
                        <div class="bg-[#fffaf5] border border-orange-100 rounded-2xl p-5">

                            <p class="text-xs uppercase font-semibold text-stone-400">
                                Role
                            </p>

                            <p class="mt-2 text-lg font-semibold text-stone-800 capitalize">
                                <%= candidate.role || "Not selected" %>
                            </p>

                        </div>

                    </div>

                </div>


                <!-- About -->
                <div class="mt-10 pt-8 border-t border-stone-100">

                    <h2 class="text-xl font-bold text-stone-900">
                        About Candidate
                    </h2>

                    <p class="mt-3 text-stone-500 leading-7">

                        <%= candidate.username || "This candidate" %>
                        is a JobFinder job seeker interested in

                        <span class="font-semibold text-orange-500">
                            <%= candidate.passion || "technology" %>
                        </span>.

                    </p>

                </div>


                <!-- Contact -->
                <div class="mt-8">

                    <a href="mailto:<%= candidate.email %>"
                        class="inline-block px-6 py-3 rounded-xl bg-orange-500 text-white font-semibold hover:bg-orange-600 transition">

                        Contact Candidate

                    </a>

                </div>

            </div>

        </div>

    </main>

</body>

</html>
```
